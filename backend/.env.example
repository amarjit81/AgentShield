DATABASE_URL="postgresql://agentshield:agentshield@localhost:5432/agentshield?schema=public"
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
APP_ORIGIN="http://localhost:5173"
# NODE_ENV=production enables Secure cookies; use HTTPS in production.

# SIMULATED (default) or SMTP. New requests save this choice; old ones keep it.
EMAIL_DELIVERY_MODE="SIMULATED"
# Gmail example: smtp.gmail.com, port 465 (TLS) or 587 (required STARTTLS).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
# Gmail requires an app password, not your normal login password. Never commit it.
SMTP_PASSWORD=""
SMTP_FROM=""
# Optional: up to 10 demo recipient shortcuts, comma-separated. Not a sending allowlist.
EMAIL_ALLOWED_RECIPIENTS=""
